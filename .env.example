# medical-data-analysis/.env.example
# 复制为 .env 后按需修改；.env 不得提交到仓库（已在 .gitignore 中排除）。
# 本文件不含任何真实密钥，仅为配置模板。

# ============================================================
# 一、通用配置（本地模式 / 云上模式共用）
# ============================================================
# 运行模式：local（本地单用户，默认） | cloud（华为云模式）
MODE=local

# 后端监听
HOST=127.0.0.1
PORT=8002

# 前端固定来源（CORS 白名单，多个用英文逗号分隔，严禁使用 *）
FRONTEND_ORIGIN=http://127.0.0.1:3001
CORS_ORIGINS=http://127.0.0.1:3001

# 上传文件大小限制（MB）
MAX_UPLOAD_MB=50

# API 访问令牌：非空时除 /api/health 外所有接口都要求 X-API-Token 头。
# 本地 127.0.0.1 单用户可留空；云上模式（公网可达）必须设置一个足够长的随机串，
# 例如：openssl rand -hex 24
API_TOKEN=

# 固定随机种子，保证建模与划分结果可复现
RANDOM_SEED=42

# ============================================================
# 二、本地模式配置（MODE=local）
# ============================================================
# 分析历史 SQLite 单文件（P2 历史持久化启用后生效）
LOCAL_SQLITE_PATH=./backend/data/history.db

# ============================================================
# 三、云上模式配置（MODE=cloud，华为云）
# ============================================================
# ---- RDS（云数据库 MySQL）：分析历史与方案文件持久化 ----
RDS_HOST=
RDS_PORT=3306
RDS_USER=
RDS_PASSWORD=
RDS_DATABASE=medical_analysis

# ---- Redis：任务状态、预测结果缓存、会话状态 ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- OBS（对象存储）：数据集、模型产物、前端静态资源 ----
OBS_AK=
OBS_SK=
OBS_SERVER=https://obs.cn-north-4.myhuaweicloud.com
OBS_BUCKET=

# ---- CDN：前端静态资源分发域名（可选） ----
CDN_DOMAIN=

# ============================================================
# 四、大模型配置（P2 AI 模块；未配置时 AI 功能自动降级为模板解读）
# ============================================================
# 服务商：deepseek | qwen | glm | modelarts_pangu | custom
LLM_PROVIDER=modelarts_pangu

# 华为云 ModelArts Studio（盘古）：Base URL 预填，鉴权头为 X-Apig-AppCode
LLM_BASE_URL=https://cn-north-4.modelarts-infer.com/api/v2
LLM_MODEL_NAME=pangu
# 密钥只存服务端内存，重启后失效；严禁写入文件或日志
LLM_API_KEY=

# 自定义 OpenAI 兼容接口（LLM_PROVIDER=custom 时使用）
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL_NAME=
